# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.aljazeerawoodz.com
NEXT_PUBLIC_WHATSAPP_NUMBER=971569321000

# ── Contact form → email (server-side only, never exposed to the client) ─
# Microsoft 365 SMTP relay. Use a mailbox's own password, or (recommended)
# an App Password / dedicated SMTP account — see docs/hosting-and-email.md.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@aljazeerawoodz.com
SMTP_PASSWORD=
EMAIL_TO=info@aljazeerawoodz.com
EMAIL_FROM=info@aljazeerawoodz.com

# ── Optional spam protection (see docs/hosting-and-email.md) ──────────
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Enquiry dashboard at /admin (see docs/hosting-and-email.md) ───────
# Postgres connection string. Easiest: Vercel → your project → Storage →
# Create Database → Postgres — Vercel fills this in for you automatically.
# Leaving it unset does not break anything: the contact form still sends
# email as normal, it just won't also save a copy to /admin.
DATABASE_URL=

# HTTP Basic Auth for /admin (shows customer names, emails, phone numbers).
# Both must be set or the dashboard responds 503 "not configured" — it
# never falls open. Pick your own values; not tied to any real account.
ADMIN_USER=
ADMIN_PASSWORD=
